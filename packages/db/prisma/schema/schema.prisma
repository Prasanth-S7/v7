generator client {
  provider = "prisma-client"
  output   = "../generated"
  moduleFormat = "esm"
  runtime = "bun"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id       String   @id @default(uuid())
  name      String?
  initialised Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}