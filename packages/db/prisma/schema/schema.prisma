generator client {
  provider = "prisma-client"
  output   = "../generated"
  moduleFormat = "esm"
  runtime = "bun"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id       String   @id @default(uuid())
  name      String?
  initialised Boolean @default(false)
  projectStatus ProjectStatus @default(IDLE)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProjectStatus {
  IDLE
  GENERATING
  ERROR
  COMPLETED
}