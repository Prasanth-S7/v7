{
	"name": "agent",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile agent",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1105.0",
		"@langchain/core": "^1.2.2",
		"@langchain/langgraph": "^1.2.9",
		"@v7/auth": "workspace:*",
		"@v7/db": "workspace:*",
		"@v7/env": "workspace:*",
		"@v7/kafka": "workspace:*",
		"@v7/llmclient": "workspace:*",
		"axios": "^1.15.2",
		"better-auth": "catalog:",
		"cors": "^2.8.5",
		"dotenv": "catalog:",
		"express": "^5.1.0",
		"langchain": "^1.3.3",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@types/bun": "catalog:",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.6",
		"@v7/config": "workspace:*",
		"tsdown": "^0.16.5",
		"typescript": "catalog:"
	}
